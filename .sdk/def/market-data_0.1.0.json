{
  "openapi": "3.0.3",
  "info": {
    "title": "Market Data API",
    "description": "This API provides access to public market data from Binance, allowing developers to retrieve information such as ticker prices, trading volume, and other essential details needed for trading applications. Its straightforward interface simplifies the process of integrating market data into various platforms.",
    "version": "1.0.0",
    "contact": {
      "url": "https://github.com/l0v3m0n3y/binancevision"
    }
  },
  "servers": [
    {
      "url": "https://data-api.binance.vision",
      "description": "Binance Market Data API Server"
    }
  ],
  "paths": {
    "/api/v3/ticker/24hr": {
      "get": {
        "summary": "Get ticker list",
        "description": "Retrieves 24-hour ticker price change statistics for all trading pairs. Returns ticker prices, trading volume, and other essential market data details.",
        "operationId": "getListTickers",
        "tags": [
          "Market Data"
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "description": "Trading pair symbol (e.g., BTCUSDT). If omitted, returns data for all symbols.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "BTCUSDT"
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "Array of trading pair symbols as JSON string. Cannot be used with symbol parameter.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "[\"BTCUSDT\",\"ETHUSDT\"]"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Ticker type (FULL or MINI). Defaults to FULL.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "FULL",
                "MINI"
              ],
              "default": "FULL"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with 24-hour ticker statistics",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Ticker24hr"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/Ticker24hr"
                    }
                  ]
                },
                "examples": {
                  "multipleSymbols": {
                    "summary": "Multiple symbols response",
                    "value": [
                      {
                        "symbol": "BTCUSDT",
                        "priceChange": "-94.99999800",
                        "priceChangePercent": "-95.960",
                        "weightedAvgPrice": "0.29628482",
                        "prevClosePrice": "0.10002000",
                        "lastPrice": "4.00000200",
                        "lastQty": "200.00000000",
                        "bidPrice": "4.00000000",
                        "bidQty": "100.00000000",
                        "askPrice": "4.00000200",
                        "askQty": "100.00000000",
                        "openPrice": "99.00000000",
                        "highPrice": "100.00000000",
                        "lowPrice": "0.10000000",
                        "volume": "8913.30000000",
                        "quoteVolume": "15.30000000",
                        "openTime": 1499783499040,
                        "closeTime": 1499869899040,
                        "firstId": 28385,
                        "lastId": 28460,
                        "count": 76
                      }
                    ]
                  },
                  "singleSymbol": {
                    "summary": "Single symbol response",
                    "value": {
                      "symbol": "BTCUSDT",
                      "priceChange": "-94.99999800",
                      "priceChangePercent": "-95.960",
                      "weightedAvgPrice": "0.29628482",
                      "prevClosePrice": "0.10002000",
                      "lastPrice": "4.00000200",
                      "lastQty": "200.00000000",
                      "bidPrice": "4.00000000",
                      "bidQty": "100.00000000",
                      "askPrice": "4.00000200",
                      "askQty": "100.00000000",
                      "openPrice": "99.00000000",
                      "highPrice": "100.00000000",
                      "lowPrice": "0.10000000",
                      "volume": "8913.30000000",
                      "quoteVolume": "15.30000000",
                      "openTime": 1499783499040,
                      "closeTime": 1499869899040,
                      "firstId": 28385,
                      "lastId": 28460,
                      "count": 76
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ticker24hr": {
        "type": "object",
        "description": "24-hour ticker price change statistics",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "Trading pair symbol",
            "example": "BTCUSDT"
          },
          "priceChange": {
            "type": "string",
            "description": "Absolute price change in the last 24 hours",
            "example": "-94.99999800"
          },
          "priceChangePercent": {
            "type": "string",
            "description": "Percentage price change in the last 24 hours",
            "example": "-95.960"
          },
          "weightedAvgPrice": {
            "type": "string",
            "description": "Weighted average price over the last 24 hours",
            "example": "0.29628482"
          },
          "prevClosePrice": {
            "type": "string",
            "description": "Previous day's close price",
            "example": "0.10002000"
          },
          "lastPrice": {
            "type": "string",
            "description": "Last traded price",
            "example": "4.00000200"
          },
          "lastQty": {
            "type": "string",
            "description": "Last traded quantity",
            "example": "200.00000000"
          },
          "bidPrice": {
            "type": "string",
            "description": "Best bid price",
            "example": "4.00000000"
          },
          "bidQty": {
            "type": "string",
            "description": "Best bid quantity",
            "example": "100.00000000"
          },
          "askPrice": {
            "type": "string",
            "description": "Best ask price",
            "example": "4.00000200"
          },
          "askQty": {
            "type": "string",
            "description": "Best ask quantity",
            "example": "100.00000000"
          },
          "openPrice": {
            "type": "string",
            "description": "Opening price 24 hours ago",
            "example": "99.00000000"
          },
          "highPrice": {
            "type": "string",
            "description": "Highest price in the last 24 hours",
            "example": "100.00000000"
          },
          "lowPrice": {
            "type": "string",
            "description": "Lowest price in the last 24 hours",
            "example": "0.10000000"
          },
          "volume": {
            "type": "string",
            "description": "Total trading volume in base asset",
            "example": "8913.30000000"
          },
          "quoteVolume": {
            "type": "string",
            "description": "Total trading volume in quote asset",
            "example": "15.30000000"
          },
          "openTime": {
            "type": "integer",
            "format": "int64",
            "description": "Opening time timestamp (milliseconds)",
            "example": 1499783499040
          },
          "closeTime": {
            "type": "integer",
            "format": "int64",
            "description": "Closing time timestamp (milliseconds)",
            "example": 1499869899040
          },
          "firstId": {
            "type": "integer",
            "format": "int64",
            "description": "First trade ID",
            "example": 28385
          },
          "lastId": {
            "type": "integer",
            "format": "int64",
            "description": "Last trade ID",
            "example": 28460
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Number of trades in the last 24 hours",
            "example": 76
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Error response object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Error code",
            "example": -1100
          },
          "msg": {
            "type": "string",
            "description": "Error message",
            "example": "Invalid parameter"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Market Data",
      "description": "Public market data endpoints for retrieving ticker prices, trading volume, and other essential trading information"
    }
  ],
  "externalDocs": {
    "description": "API Documentation on GitHub",
    "url": "https://github.com/l0v3m0n3y/binancevision"
  }
}
